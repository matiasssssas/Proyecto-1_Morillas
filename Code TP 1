#define LED_R1 3
#define LED_G1 5
#define LED_B1 11
#define LED_R2 2
#define LED_G2 6
#define LED_B2 4
#define LED_R3 8
#define LED_G3 10
#define LED_B3 9
#define BUZZER 7   

void setup() {
  pinMode(LED_R1, OUTPUT);
  pinMode(LED_G1, OUTPUT);
  pinMode(LED_B1, OUTPUT);
  pinMode(LED_R2, OUTPUT);
  pinMode(LED_G2, OUTPUT);
  pinMode(LED_B2, OUTPUT);
  pinMode(LED_R3, OUTPUT);
  pinMode(LED_G3, OUTPUT);
  pinMode(LED_B3, OUTPUT);
  pinMode(BUZZER, OUTPUT);
}

void loop() {
  
  analogWrite(LED_R1, 255);
  delay(1000);
  analogWrite(LED_R1, 0);

 
  analogWrite(BUZZER, 200);
  delay(100);
  analogWrite(BUZZER, 0);


  digitalWrite(LED_R2, HIGH);
  digitalWrite(LED_B2, HIGH);
  delay(1000);
  digitalWrite(LED_R2, LOW);
  digitalWrite(LED_B2, LOW);

  analogWrite(BUZZER, 200);
  delay(100);
  analogWrite(BUZZER, 0);

  
  analogWrite(LED_G3, 50);
  analogWrite(LED_B3, 50);
  delay(1000);
  analogWrite(LED_G3, 0);
  analogWrite(LED_B3, 0);

  analogWrite(BUZZER, 200);
  delay(100);
  analogWrite(BUZZER, 0);
}
